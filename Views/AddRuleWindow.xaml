<Window x:Class="RouteAgent.Views.AddRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="添加应用" Width="620" Height="436" ResizeMode="NoResize" WindowStyle="None"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}">
                <TextBlock Text="添加应用" FontSize="13" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseWindowButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,8,22,0">
                <TextBlock Text="应用程序" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource SunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="AppIcon" Width="20" Height="20"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>

                    <TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource InputBox}"
                             IsReadOnly="True" Margin="6,0,0,0" VerticalAlignment="Center"
                             ToolTip="选择一个 .exe 程序" />
                    <Button Grid.Column="2" Content="浏览…" Style="{StaticResource SecondaryButton}"
                            Padding="14,7" Margin="10,0,0,0" Click="Browse_Click" />
                </Grid>

                <TextBlock Text="出口网卡" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,18,0,0" />
                <ComboBox x:Name="AdapterCombo" Style="{StaticResource ComboBoxStyle}" Margin="0,8,0,0"
                          DisplayMemberPath="Display" SelectedValuePath="Name" Height="36" />

                <CheckBox x:Name="ChildrenCheck" Style="{StaticResource CheckBoxStyle}" FontSize="12.5"
                          Content="包含安装目录下的子进程" Margin="0,16,0,0"
                          ToolTip="勾选后，该程序安装目录下的其它程序（子进程）也走同一张网卡" />

                <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0" LineHeight="20"
                           Text="规则按进程名匹配：该程序的所有 TCP / UDP 连接都会从所选网卡的源地址发出。部分系统服务（例如 DNS 客户端）不属于该进程，仍走默认网络。" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,18,0">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Height="32"
                            Click="Cancel_Click" />
                    <Button x:Name="OkButton" Content="添加" Style="{StaticResource PrimaryButton}" Width="104"
                            Height="32" Margin="10,0,0,0" IsEnabled="False" Click="Ok_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
