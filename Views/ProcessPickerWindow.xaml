<Window x:Class="RouteAgent.Views.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="选择运行中的程序" Width="800" Height="640" MinWidth="660" MinHeight="520"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Grid Background="{DynamicResource TitleBarBrush}">
                <TextBlock Text="从运行中的程序选择" FontSize="13" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseWindowButton}"
                        HorizontalAlignment="Right" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,14,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Height="34"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                             TextChanged="SearchBox_TextChanged"
                             ToolTip="按程序名称或路径搜索" />
                    <TextBlock x:Name="SearchHint" Text="搜索程序名称或路径…" IsHitTestVisible="False"
                               Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,0">
                <ListBox x:Name="ProcessList" Style="{StaticResource PlainListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,5" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Style="{StaticResource CheckBoxStyle}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                    <Border Grid.Column="1" Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource SunkenBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Icon}" Width="18" Height="18"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="LoadingText" Text="正在读取进程列表…" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <TextBlock x:Name="EmptyText" Text="没有找到匹配的程序，换个关键词试试" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="出口网卡" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="AdapterCombo" Style="{StaticResource ComboBoxStyle}" Width="240"
                                  Height="32" Margin="10,0,0,0"
                                  DisplayMemberPath="Display" SelectedValuePath="Name" />
                        <TextBlock x:Name="SelectedCountText" Text="已选择 0 项" FontSize="12" Margin="16,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Style="{StaticResource SecondaryButton}" Width="92" Height="32"
                                Click="Cancel_Click" />
                        <Button Content="添加所选" Style="{StaticResource PrimaryButton}" Width="116" Height="32"
                                Margin="10,0,0,0" Click="Ok_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
