<Window x:Class="RouteAgent.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:RouteAgent.Converters"
        Title="RouteAgent" Width="1160" Height="780" MinWidth="980" MinHeight="640"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="Window_Closing" Loaded="Window_Loaded" StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />

        <ControlTemplate x:Key="FlatTabControl" TargetType="TabControl">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
        </ControlTemplate>

        <!-- 规则分组的标题：网卡名 + 规则数 -->
        <DataTemplate x:Key="RuleGroupHeader">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="16" CornerRadius="2"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Padding="8,1" Margin="10,0,0,0" CornerRadius="9"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCount, StringFormat={}{0} 条}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 可折叠的分组：点标题展开 / 收起 -->
        <Style x:Key="RuleGroupExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" Focusable="False" Cursor="Hand"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                Padding="8,4" Margin="0,0,4,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <Path x:Name="Chevron" Grid.Column="1" Margin="10,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Data="M0,0 L4,4 L0,8"
                                                      Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource SurfaceHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" CenterX="2" CenterY="4" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,2,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ================= 自定义标题栏 ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF5B8DEF" Offset="0" />
                                <GradientStop Color="#FF3766C9" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#x21C4;" FontSize="13" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RouteAgent" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <Border Width="1" Height="15" Background="{DynamicResource BorderBrush}" Margin="10,0" />
                    <TextBlock Text="应用级网卡分流" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" Padding="9,4" Margin="0,0,10,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="启动分流" Style="{StaticResource PrimaryButton}" Padding="14,5" Height="28"
                            Margin="0,0,6,0" Click="Start_Click" IsEnabled="{Binding CanStart}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="停止" Style="{StaticResource SecondaryButton}" Padding="14,5" Height="28"
                            Margin="0,0,10,0" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                    <Button Style="{StaticResource WindowButton}" Click="Minimize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0,0 H10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid>
                            <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                            <Path x:Name="RestoreGlyph" Visibility="Collapsed"
                                  Data="M2.5,0.5 H9.5 V7.5 H2.5 Z M0.5,2.5 H7.5 V9.5 H0.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.1" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= 提示条 ================= -->
            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource BannerWarnBackgroundBrush}" BorderBrush="{DynamicResource BannerWarnBorderBrush}" BorderThickness="0,1,0,1"
                        Padding="18,9" Visibility="{Binding ShowAdminBanner, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="当前以普通权限运行，创建 TUN 虚拟网卡需要管理员权限。"
                                       Foreground="{DynamicResource BannerWarnTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="以管理员身份重启" Style="{StaticResource SecondaryButton}" Padding="12,5"
                                Height="28" HorizontalAlignment="Right" Click="Elevate_Click" />
                    </Grid>
                </Border>

                <Border Background="{DynamicResource BannerInfoBackgroundBrush}" BorderBrush="{DynamicResource BannerInfoBorderBrush}" BorderThickness="0,1,0,1"
                        Padding="18,9"
                        Visibility="{Binding IsCoreReady, Converter={StaticResource InverseBoolToVisibility}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource BannerInfoIconBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="还没有安装分流内核，安装后才能按应用选择出口网卡。"
                                       Foreground="{DynamicResource BannerInfoTextBrush}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="安装内核" Style="{StaticResource PrimaryButton}" Padding="14,5"
                                Height="28" HorizontalAlignment="Right" Click="InstallCore_Click" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox x:Name="Nav" Grid.Row="0" Style="{StaticResource NavList}" SelectedIndex="0"
                                 Margin="0,12,0,0">
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Width="22" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="应用规则" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Width="22" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="网络网卡" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Width="22" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="设置" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               Width="22" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="运行日志" Margin="8,0,0,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="18,0,18,16">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding CoreStatusText}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CoreVersionText}" FontSize="10.5" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding CoreVersionText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容 -->
                <TabControl x:Name="Pages" Grid.Column="1" Background="Transparent" BorderThickness="0"
                            Template="{StaticResource FlatTabControl}"
                            SelectedIndex="{Binding ElementName=Nav, Path=SelectedIndex, Mode=OneWay}">

                    <!-- ============ 应用规则 ============ -->
                    <TabItem>
                        <Grid Margin="24,18,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="应用规则" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,0"
                                               Text="为每个应用指定出口网卡。规则按进程名匹配，没有匹配到的进程与系统服务走默认网络。" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="从运行中的程序选择" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,10,0" Click="PickProcess_Click" />
                                    <Button Style="{StaticResource PrimaryButton}" Click="AddApp_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                       Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="添加应用" Foreground="White" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,16,4,12" Background="{DynamicResource SunkenBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                    Padding="12,7">
                                <Grid>
                                    <TextBlock Text="{Binding RuleSummary}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding AdapterSummary}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GroupedRules}" Margin="0,0,4,0">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander Style="{StaticResource RuleGroupExpander}" IsExpanded="True">
                                                                        <Expander.Header>
                                                                            <ContentControl Content="{TemplateBinding Content}"
                                                                                            ContentTemplate="{StaticResource RuleGroupHeader}" />
                                                                        </Expander.Header>
                                                                        <ItemsPresenter />
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="104" />
                                                            <ColumnDefinition Width="196" />
                                                            <ColumnDefinition Width="52" />
                                                            <ColumnDefinition Width="34" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="34" Height="34" CornerRadius="9"
                                                                Background="{DynamicResource SunkenBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <Grid>
                                                                <TextBlock Text="&#xE7C3;"
                                                                           FontFamily="{StaticResource IconFont}" FontSize="15"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <Image Source="{Binding Icon}" Width="20" Height="20"
                                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <CheckBox Grid.Column="2" Style="{StaticResource CheckBoxStyle}"
                                                                  Content="含子进程" FontSize="12"
                                                                  IsChecked="{Binding IncludeChildren, Mode=TwoWay}"
                                                                  IsEnabled="{Binding CanIncludeChildren}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                                  ToolTip="勾选后，该程序安装目录下的其它程序（子进程）也走这张网卡" />

                                                        <ComboBox Grid.Column="3" Style="{StaticResource ComboBoxStyle}"
                                                                  Width="186" Height="32" VerticalAlignment="Center"
                                                                  ItemsSource="{Binding DataContext.Adapters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Display" SelectedValuePath="Name"
                                                                  SelectedValue="{Binding AdapterName, Mode=TwoWay}" />

                                                        <CheckBox Grid.Column="4" Style="{StaticResource ToggleSwitch}"
                                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                  ToolTip="启用 / 停用这条规则" />

                                                        <Button Grid.Column="5" Style="{StaticResource IconButton}"
                                                                Click="RemoveRule_Click" ToolTip="删除规则"
                                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <Path Data="M2.5,4 H13.5 M6,4 V2.6 H10 V4 M4.2,4 L5,13.4 H11 L11.8,4 M7.2,6.6 V11.2 M9.8,6.6 V11.2"
                                                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border Visibility="{Binding HasRules, Converter={StaticResource InverseBoolToVisibility}}"
                                        Background="{DynamicResource SunkenBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource SunkenBrush}"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="还没有任何分流规则" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,16,0,0" HorizontalAlignment="Center" />
                                        <TextBlock Text="添加应用后，为它选择一张出口网卡即可"
                                                   Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                   HorizontalAlignment="Center" />
                                        <Button Content="添加第一个应用" Style="{StaticResource PrimaryButton}"
                                                Margin="0,18,0,0" HorizontalAlignment="Center" Click="AddApp_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ============ 网络网卡 ============ -->
                    <TabItem>
                        <Grid Margin="24,18,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="网络网卡" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,0"
                                               Text="这里是当前系统识别到的网卡。规则中的「出口网卡」就是这里的网卡名称（mihomo 通过 interface-name 绑定）。" />
                                </StackPanel>
                                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="RefreshAdapters_Click" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" Margin="0,16,4,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Adapters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="410" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Border CornerRadius="8" Padding="7,2" Margin="0,0,6,0"
                                                                    Background="{DynamicResource SuccessSoftBrush}">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                           Foreground="{Binding StatusColor}" />
                                                            </Border>
                                                            <Border CornerRadius="8" Padding="7,2" Background="{DynamicResource TagBrush}"
                                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="默认出口" FontSize="10"
                                                                           Foreground="{DynamicResource AccentHoverBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"
                                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Description}" />

                                                    <Border Height="1" Background="{DynamicResource BorderBrush}"
                                                            Margin="0,10,0,10" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="72" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="22" />
                                                            <RowDefinition Height="22" />
                                                            <RowDefinition Height="22" />
                                                            <RowDefinition Height="22" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="IPv4" Style="{StaticResource Caption}" />
                                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IPv4}"
                                                                   FontSize="12" FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Grid.Row="1" Text="网关" Style="{StaticResource Caption}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gateway}"
                                                                   FontSize="12" FontFamily="{StaticResource MonoFont}" />
                                                        <TextBlock Grid.Row="2" Text="DNS" Style="{StaticResource Caption}" />
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Dns}"
                                                                   FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="3" Text="类型 / 速率" Style="{StaticResource Caption}" />
                                                        <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12">
                                                            <Run Text="{Binding TypeText}" />
                                                            <Run Text=" · " />
                                                            <Run Text="{Binding SpeedText}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ============ 设置 ============ -->
                    <TabItem>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,18,20,20" MaxWidth="820" HorizontalAlignment="Left">

                                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,0"
                                           Text="所有设置都会即时保存，规则变更会在下次启动分流时生效。" />

                                <!-- 常规 -->
                                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="常规" Style="{StaticResource SectionTitle}" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="外观主题" FontSize="13" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                           Text="切换后立即生效，并记住你的选择。" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="120" Style="{StaticResource ComboBoxStyle}"
                                                      VerticalAlignment="Center"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Theme, Mode=TwoWay}">
                                                <ComboBoxItem Content="深色" Tag="Dark" />
                                                <ComboBoxItem Content="浅色" Tag="Light" />
                                            </ComboBox>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="启动应用后自动开启分流" FontSize="13" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                           Text="以管理员身份启动时，自动按现有规则开始分流。" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Settings.AutoStartRouting, Mode=TwoWay}" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="关闭窗口时最小化到托盘" FontSize="13" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                           Text="关闭主界面后继续在后台维持分流。" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}" />
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,0" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="开机自动启动" FontSize="13" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                           Text="创建计划任务，登录后以管理员权限静默启动。" />
                                            </StackPanel>
                                            <CheckBox x:Name="AutoStartToggle" Grid.Column="1"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Settings.AutoStartWithWindows, Mode=OneWay}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 内核 -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="内核" Style="{StaticResource SectionTitle}" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCoreReady}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding CoreStatusText}" FontSize="11"
                                                           Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding CoreVersionText}" Style="{StaticResource Caption}"
                                                   Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                   Text="{Binding CoreDirectory, StringFormat=内核目录：{0}}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Muted}"
                                                   Margin="0,10,0,0"
                                                   Visibility="{Binding DownloadText, Converter={StaticResource StringNotEmptyToVisibility}}" />

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="安装 / 更新内核" Style="{StaticResource PrimaryButton}"
                                                    Padding="14,6" Click="InstallCore_Click" />
                                            <Button Content="打开内核目录" Style="{StaticResource SecondaryButton}"
                                                    Padding="14,6" Margin="10,0,0,0" Click="OpenCoreDir_Click" />
                                            <Button Content="打开配置文件" Style="{StaticResource SecondaryButton}"
                                                    Padding="14,6" Margin="10,0,0,0" Click="OpenConfig_Click" />
                                        </StackPanel>

                                        <TextBlock Text="点「安装 / 更新内核」打开安装窗口：可自动下载、粘贴自定义地址，或导入本地文件。"
                                                   Style="{StaticResource Caption}" Margin="0,12,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 高级 -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="高级" Style="{StaticResource SectionTitle}" />

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="接管 DNS（fake-ip）" FontSize="13" />
                                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                                           Text="开启后所有域名解析由内核处理。默认关闭，交给系统 DNS 客户端，兼容性更好。" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding Settings.EnableDnsHijack, Mode=TwoWay}" />
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="DNS 服务器" VerticalAlignment="Center" FontSize="13" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                     Text="{Binding Settings.Nameservers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsEnabled="{Binding Settings.EnableDnsHijack}"
                                                     ToolTip="多个服务器用逗号分隔，例如 223.5.5.5, 10.1.1.10" />
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="日志级别" VerticalAlignment="Center" FontSize="13" />
                                            <ComboBox Grid.Column="1" Style="{StaticResource ComboBoxStyle}"
                                                      SelectedValue="{Binding Settings.LogLevel, Mode=TwoWay}"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="info" Tag="info" />
                                                <ComboBoxItem Content="warning" Tag="warning" />
                                                <ComboBoxItem Content="error" Tag="error" />
                                                <ComboBoxItem Content="debug" Tag="debug" />
                                            </ComboBox>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="TUN 设备名" VerticalAlignment="Center" FontSize="13" />
                                            <TextBox Grid.Column="1" Style="{StaticResource InputBox}"
                                                     Text="{Binding Settings.TunDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 说明 -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="工作原理与注意事项" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" LineHeight="21"
                                                   Text="• 通过 mihomo 内核创建 TUN 虚拟网卡接管系统流量，规则按进程名（PROCESS-NAME）匹配。&#x0a;• 每条规则对应一个 direct 出站，使用 interface-name 绑定到指定网卡，因此该应用的 TCP / UDP 流量会从所选网卡的源地址发出。&#x0a;• 未匹配的进程、系统服务与 DNS 查询按系统默认路由（默认网卡）发送。&#x0a;• 内网应用若用域名访问，请确保系统能通过内网网卡解析到该域名，或开启 DNS 接管并添加内网 DNS。&#x0a;• 开启/停止分流需要管理员权限；退出程序前请先停止分流。" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ============ 日志 ============ -->
                    <TabItem>
                        <Grid Margin="24,18,20,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="运行日志" Style="{StaticResource PageTitle}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,7,0,0"
                                               Text="包含程序操作记录与内核输出，便于排查分流失败的原因。" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LogPausedText}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button x:Name="PauseLogButton" Content="{Binding LogPauseButtonText}"
                                            Style="{StaticResource SecondaryButton}" Padding="14,7" Width="72"
                                            Click="PauseLogs_Click" />
                                    <Button Content="清空" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                            Margin="10,0,0,0" Click="ClearLogs_Click" />
                                    <Button Content="打开日志文件" Style="{StaticResource SecondaryButton}" Padding="14,7"
                                            Margin="10,0,0,0" Click="OpenLog_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="0,16,4,0" Background="{DynamicResource LogPanelBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}"
                                         Style="{StaticResource PlainListBox}" Margin="12,10"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ================= 状态栏 ================= -->
            <Border Grid.Row="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding RuleSummary}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CoreVersionText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
