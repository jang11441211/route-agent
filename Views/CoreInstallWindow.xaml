<Window x:Class="RouteAgent.Views.CoreInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:RouteAgent.Converters"
        Title="安装内核" Width="620" Height="566" ResizeMode="NoResize" WindowStyle="None"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Background="{DynamicResource TitleBarBrush}">
                <TextBlock Text="安装内核" FontSize="13" FontWeight="SemiBold" Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseWindowButton}" HorizontalAlignment="Right"
                        Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1" />
                </Button>
            </Grid>

            <!-- 内容 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,14,22,0">
                <StackPanel>
                    <TextBlock Text="当前状态" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCoreReady}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding CoreStatusText}" FontSize="14" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding CoreVersionText}" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Text="{Binding CoreDirectory, StringFormat=安装目录：{0}}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="下载方式" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="内核 mihomo.exe 与 TUN 驱动 wintun.dll 会一起安装。自动下载会依次尝试多个镜像，某个源不通时会自动换下一个。" />

                    <Button Content="自动下载（推荐）" Style="{StaticResource PrimaryButton}"
                            Height="36" Margin="0,12,0,0" Click="AutoDownload_Click" />

                    <TextBlock Text="{Binding DownloadText}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding DownloadText, Converter={StaticResource StringNotEmptyToVisibility}}" />

                    <Grid Margin="0,18,0,0">
                        <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource WindowBackgroundBrush}" HorizontalAlignment="Center"
                                Padding="10,0">
                            <TextBlock Text="或" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0"
                               Text="如果你有可用的下载地址（zip 压缩包或 mihomo.exe 直链），粘贴到这里：" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource InputBox}" Height="34" Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="https://…/mihomo-windows-amd64-compatible-v1.19.2.zip" />
                        <Button Grid.Column="1" Content="下载该地址" Style="{StaticResource SecondaryButton}"
                                Padding="12,6" Margin="8,0,0,0" Click="DownloadUrl_Click" />
                    </Grid>

                    <Button Content="从本地文件导入…" Style="{StaticResource SecondaryButton}"
                            Padding="14,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                            Click="Import_Click" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部 -->
            <Grid Grid.Row="2" Background="{DynamicResource TitleBarBrush}">
                <Border Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Top" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Button Content="打开内核目录" Style="{StaticResource GhostButton}"
                            Padding="12,6" Click="OpenDir_Click" />
                </StackPanel>
                <Button Content="关闭" Style="{StaticResource SecondaryButton}" Padding="18,6"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                        Click="Close_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
